# ---- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Where all data lives (users, buckets, raw mails, backups). Default: ./data
# DATA_DIR=D:\ticketvault-data
# Registration needs this code (first account registers without it and becomes admin)
INVITE_CODE=change-me
# Optional: fixed JWT secret. If empty, one is generated into data/jwt-secret.txt
# JWT_SECRET=
JWT_DAYS=90

# ---- Claude extraction ---------------------------------------------------------
# API key from console.anthropic.com. Without it the server still works, only
# the e-mail extraction falls back to the deterministic parsers.
ANTHROPIC_API_KEY=
# Default is claude-opus-5. Cheaper option for bulk mail: claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
LLM_ENABLED=true

# ---- IMAP ingest --------------------------------------------------------------
INGEST_ENABLED=true
# Reconcile poll (minutes) in addition to IDLE push
INGEST_POLL_MINUTES=5
# On first run, how far back to read each mailbox
INGEST_BACKFILL_DAYS=30
# Skip mails whose subject/sender look unrelated (saves API calls). false = send everything to Claude
INGEST_PREFILTER=true
# Mailboxes: put them in data/mailboxes.json (see README) or inline here as JSON:
# MAILBOXES=[{"name":"gmail-1","email":"x@gmail.com","pass":"xxxx xxxx xxxx xxxx","owner":"michal"},{"name":"seznam-1","email":"y@seznam.cz","pass":"heslo","owner":"michal"}]

# ---- Digest / e-mail sending (optional) ------------------------------------------
DIGEST_HOURS=8,18
# SMTP_HOST=smtp.seznam.cz
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=y@seznam.cz
# SMTP_PASS=heslo
# SMTP_FROM=y@seznam.cz

# ---- Sales -------------------------------------------------------------------
# Marketplace mails (Stubhub/Viagogo/SyncSeats: sold, delivered, payout) are applied
# directly to the inventory when exactly one ticket matches. false = always a card.
AUTO_APPLY_SALES=true

# ---- Ticket delivery drafts (1.19) ------------------------------------------------
# Mailbox (e-mail or name from data/mailboxes.json) whose Gmail Drafts folder receives the
# e-mails with SeatLabs ticket links for buyers. Drafts are never sent automatically.
# DELIVERY_MAILBOX=sales@gmail.com
# DELIVERY_FROM_NAME=Michal Šmída
